<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gemini_strip_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="3dp"
    android:paddingBottom="2dp">

    <!-- Mode Ringkas (Tersembunyi): hanya tombol mungil untuk memunculkan lagi -->
    <LinearLayout
        android:id="@+id/gemini_collapsed_bar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_gemini_expand"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✨ ▴"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mode Normal: Tanya Gemini + Pintasan Cepat + Tombol Sembunyikan -->
    <LinearLayout
        android:id="@+id/gemini_idle_bar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/btn_gemini_open"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="✨ Tanya Gemini"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_gemini_translate"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Terjemahkan"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_gemini_fix"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Perbaiki"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_gemini_collapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▾"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mode Aktif: Mengetik Prompt untuk Gemini -->
    <LinearLayout
        android:id="@+id/gemini_active_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_gemini_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="3"
            android:text="Ketik pertanyaan untuk Gemini..."
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_gemini_grab"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="📋"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_gemini_send"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Kirim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_gemini_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
